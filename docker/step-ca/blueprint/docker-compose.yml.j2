---
name: {{app.name}}

services:
  app:
    image: smallstep/step-ca
    # https://hub.docker.com/r/smallstep/step-ca

    container_name: {{app.name}}
    environment:
      - DOCKER_STEPCA_INIT_NAME=Smallstep Local ({{global.domain}})
      - DOCKER_STEPCA_INIT_DNS_NAMES=localhost,ca.{{global.domain}}
      - DOCKER_STEPCA_INIT_REMOTE_MANAGEMENT=true
      - DOCKER_STEPCA_INIT_ACME=true
      - DOCKER_STEPCA_INIT_PASSWORD={{global.password | b64decode}}
    networks:
      {{docker.infra.proxy_network}}:
        aliases:
          - ca.{{global.domain}}
    volumes:
      - files:/home/step
    ports:
      - 127.0.0.1:9000:9000
    restart: unless-stopped

networks:
  {{docker.infra.proxy_network}}:
    external: true

volumes:
  files:
