---
{% import 'utils.j2' as utils %}
name: {{app.name}}

services:
  app:
    image: httpd:latest

    container_name: {{app.name}}
    
    networks:
      - {{docker.infra.proxy_network}}
    volumes:
      - ./mnt:/usr/local/apache2/htdocs
    restart: unless-stopped
{{ utils.standard_labels(docker, app, app.fqdn, 80) }}

networks:
  {{docker.infra.proxy_network}}:
    external: true
