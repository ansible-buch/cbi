---
{% import 'utils.j2' as utils %}
name: {{app.name}}

services:
  app:
    image: "roundcube/roundcubemail:latest-apache"
    # https://hub.docker.com/r/roundcube/roundcubemail/
    container_name: {{app.cbiname}}-app
    environment:
      - ROUNDCUBEMAIL_DEFAULT_HOST=tls://mail.{{global.domain}}
      - ROUNDCUBEMAIL_SMTP_SERVER=tls://mail.{{global.domain}}
      - ROUNDCUBEMAIL_PLUGINS=archive,zipdownload,managesieve
      - ROUNDCUBEMAIL_UPLOAD_MAX_FILESIZE=50M
      - ROUNDCUBEMAIL_SKIN=larry

      - ROUNDCUBEMAIL_DB_TYPE=pgsql
      - ROUNDCUBEMAIL_DB_HOST=db
      - ROUNDCUBEMAIL_DB_USER=roundcube
      - ROUNDCUBEMAIL_DB_PASSWORD=roundcube
      - ROUNDCUBEMAIL_DB_NAME=roundcube

    networks:
      - {{docker.infra.proxy_network}}
      - backend

    volumes:
      - ./mnt/config:/var/roundcube/config
      - app_files:/var/www/html
      - app_tmp:/tmp/roundcube-temp

      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro

    restart: unless-stopped
    labels:
{{ utils.traefik_labels(docker, app.name, [app.fqdn, 'webmail.' ~ global.domain], 80) }}

    depends_on:
      - db


  db:
    image: postgres:17
    container_name: {{app.cbiname}}-db
    volumes:
      - data_17:/var/lib/postgresql/data
    environment:
      - POSTGRES_PASSWORD=roundcube
      - POSTGRES_USER=roundcube
    networks:
      - backend
    restart: unless-stopped

networks:
  backend:
  {{docker.infra.proxy_network}}:
    external: true

volumes:
  app_files:
  app_tmp:
  data_17:
