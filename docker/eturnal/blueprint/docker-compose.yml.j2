---
name: {{app.name}}

services:
  app:
    image: eturnal/eturnal:latest
    hostname:       {{app.cbiname}}
    container_name: {{app.cbiname}}

    cap_drop:
      - ALL
    cap_add:
      - NET_BIND_SERVICE
    security_opt:
      - no-new-privileges:true

    network_mode: host

    volumes:
      - ./mnt/eturnal.yml:/etc/eturnal.yml:ro
      - files:/opt/eturnal
      
    restart: unless-stopped


volumes:
  files:
