---
{% import 'utils.j2' as utils %}
name: {{app.name}}

services:
  app:
    image: redmine:6
    
    container_name: {{app.cbiname}}-app
    environment:
      - REDMINE_DB_POSTGRES=db
      - REDMINE_DB_USERNAME=redmine
      - REDMINE_DB_PASSWORD=redmine
      - REDMINE_DB_DATABASE=redmine
      - REDMINE_PLUGINS_MIGRATE=true
    networks:
      - {{docker.infra.proxy_network}}
      - backend
    volumes:
      - files:/usr/src/redmine/files
      - plugins:/usr/src/redmine/plugins
    restart: unless-stopped
{{ utils.standard_labels(docker, app, 3000) }}

    depends_on:
      - db

  db:
    image: postgres:17
    container_name: {{app.cbiname}}-db
    volumes:
      - data_17:/var/lib/postgresql/data
    environment:
      - POSTGRES_PASSWORD=redmine
      - POSTGRES_USER=redmine
    networks:
      - backend
    restart: unless-stopped

networks:
  backend:
  {{docker.infra.proxy_network}}:
    external: true

volumes:
  files:
  plugins:
  data_17:
