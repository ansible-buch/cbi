---
http:
  routers:
{% for d in app.extra_acme_domains %}
    {{ d.router }}:
      rule: Host(`{{d.domain}}`)
      entryPoints: [websecure]
      tls:
{% if docker.infra.cert_resolver %}
        certResolver: {{docker.infra.cert_resolver}}
{% endif %}
      service: noop
{% endfor %}
  services:
    noop:
      loadBalancer:
        servers: [{ url: "http://127.0.0.1" }]
