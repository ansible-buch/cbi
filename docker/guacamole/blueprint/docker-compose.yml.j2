---
{% import 'utils.j2' as utils %}
name: {{app.name}}

services:
  app:
    image: guacamole/guacamole

    container_name: {{app.cbiname}}-app
    environment:
      - GUACAMOLE_HOME=/guacamole_home # Default /etc/guacamole does not work!
      - GUACD_HOSTNAME=daemon
      - WEBAPP_CONTEXT=ROOT   # no need for the /guacamole sub-URL
    networks:
      - {{docker.infra.proxy_network}}
      - backend
    volumes:
      - ./mnt/config:/guacamole_home
    restart: unless-stopped
    labels:
{{ utils.traefik_labels(docker, app.name, [app.fqdn], 8080) }}


  daemon:
    image: guacamole/guacd
    container_name: {{app.cbiname}}-daemon
    networks:
      - backend
    restart: unless-stopped


networks:
  backend:
  {{docker.infra.proxy_network}}:
    external: true


volumes:
  data:
