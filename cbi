for ver in 3.14 3.13 3.12 3.11 3.10 3.9 3; do
  if command -v "python$ver" >/dev/null 2>&1; then
    exec "python$ver" "$0" "$@"
  fi
done
echo "Error: No suitable Python found." >&2
